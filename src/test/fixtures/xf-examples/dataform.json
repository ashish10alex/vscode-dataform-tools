            "type": "table",
            "target": {
                "schema": "xf_example",
                "name": "dim_customers",
                "database": "alex-personal-dev-01"
            },
            "query": "\n\n\n\nWITH orders AS (\n  SELECT\n    o.customer_id,\n    MIN(o.order_date) AS first_order_date,\n    COUNT(*) AS order_count,\n    SUM(p.amount) AS lifetime_value\n  FROM `alex-personal-dev-01.xf_example.stg_orders` AS o\n  LEFT JOIN `alex-personal-dev-01.xf_example.stg_payments` AS p USING (order_id)\n  GROUP BY 1\n)\nSELECT\n  c.customer_id,\n  c.email,\n  c.country_code,\n  o.first_order_date,\n  COALESCE(o.order_count, 0) AS order_count,\n  COALESCE(o.lifetime_value, 0) AS lifetime_value\nFROM `alex-personal-dev-01.xf_example.stg_customers` AS c\nLEFT JOIN orders AS o USING (customer_id)\n\n\n",
            "disabled": false,
            "preOps": [
                "\n  DECLARE run_started TIMESTAMP DEFAULT CURRENT_TIMESTAMP();\n"
            ],
            "postOps": [
                "\n  ALTER TABLE `alex-personal-dev-01.xf_example.dim_customers` SET OPTIONS (description = \"Customers with their order history\")\n"
            ],
            "fileName": "definitions/marts/dim_customers.sqlx",
            "bigquery": {
                "partitionBy": "first_order_date",
                "clusterBy": [
                    "customer_id"
                ]
            },
            "tags": [
                "marts",
                "daily"
            ],
            "actionDescriptor": {
                "description": "Customers with their order history.",
                "columns": [
                    {
                        "description": "Primary key.",
                        "path": [
                            "customer_id"
                        ]
                    },
                    {
                        "description": "Date of the customer's first order.",
                        "path": [
                            "first_order_date"
                        ]
                    },
                    {
                        "description": "Sum of successful payments, in dollars.",
                        "path": [
                            "lifetime_value"
                        ]
                    }
                ]
            },
            "dependencyTargets": [
                {
                    "schema": "xf_example",
